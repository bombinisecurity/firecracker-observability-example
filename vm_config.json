{
  "boot-source": {
    "kernel_image_path": "./kernel-output/vmlinux-6.8.12-firecracker-minimal",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off nomodules rw root=/dev/vda init=/init.sh lsm=lockdown,capability,bpf"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "rootfs.ext4",
      "is_root_device": true,
      "is_read_only": false,
      "cache_type": "Unsafe"
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 512
  },
  "vsock": {
    "vsock_id": "vsock0",
    "guest_cid": 3,
    "uds_path": "/tmp/bombini_stream.sock"
  }
}
